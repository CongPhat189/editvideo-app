# Copy thành .env rồi điền. KHÔNG đưa file .env lên git.
APP_TITLE=Connector Screen BE
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=INFO

# Chạy sau Nginx/load balancer: đặt IP của proxy, để giới hạn tần suất tính đúng theo từng user. Đừng đặt *.
# FORWARDED_ALLOW_IPS=10.0.0.1

# Nhiều domain cách nhau dấu phẩy, * = cho phép tất cả
CORS_ORIGINS=*

# ---------- Supabase: thiếu thì các API mobile trả 503, API demo /api/* vẫn chạy ----------
# LƯU Ý: DATABASE_URL giờ là Supabase. Trước đây biến này trỏ tới database demo, nay đổi thành LOCAL_DATABASE_URL.
# Supabase Dashboard -> Connect -> Session pooler (cổng 5432). Bỏ mật khẩu ra khỏi URL, điền ở DB_PASSWORD.
DATABASE_URL=postgresql://postgres.uzgccexajrahaumdofqy@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# Mật khẩu database (Project Settings -> Database -> Reset database password nếu quên)
DB_PASSWORD=


# Khóa ký JWT của app mobile, ít nhất 32 ký tự. Tạo bằng: openssl rand -base64 48
# Tự backend cấp và kiểm tra token. Đổi khóa thì mọi người phải đăng nhập lại.
AUTH_JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Khóa mã hóa API key của agent (agents.key). Tạo bằng:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Mất khóa này thì phải đặt lại API key của mọi agent.
AGENT_KEY_ENCRYPTION_KEY=
# true: nhận cả số nước ngoài (mặc định chỉ số Việt Nam)
ALLOW_INTERNATIONAL_PHONES=false

# ---------- Lưu file đính kèm (Supabase Storage) ----------
# Project Settings -> API Keys. Key sb_secret_... chỉ dùng ở backend, không đưa cho app
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------- GoClaw ----------
# mock = trả lời giả để chạy thử; live = gọi GoClaw thật (/v1/agents/{agent_key}/wake)
GOCLAW_MODE=mock
# Dự phòng khi agent chưa có key
GOCLAW_API_KEY=
GOCLAW_TIMEOUT_SECONDS=120
# Worker gửi tin đặt lịch (POST /schedules), mỗi bao nhiêu giây kiểm tra một lần
SCHEDULE_WORKER_ENABLED=true
SCHEDULE_POLL_SECONDS=15
GOCLAW_BASE_URL=https://api.goclaw.com

# ---------- API demo /api/* ----------
# Đặt false khi lên production: các API này chưa kiểm tra đăng nhập
ENABLE_DEMO_API=true
# Đổi chuỗi bí mật này khi chạy thật
JWT_SECRET=connector-screen-demo-secret
JWT_ALGORITHM=HS256
# Database riêng của API demo. Để trống = dùng SQLite backend/connector_screen.db.
# Không trỏ vào Supabase được: bảng demo không có RLS nên app sẽ từ chối. Database khác SQLite phải đặt thêm
# ALLOW_NON_SQLITE_LOCAL_DB=true.
# LOCAL_DATABASE_URL=
