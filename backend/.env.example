# Copy thành .env rồi điền. KHÔNG đưa file .env lên git.

# Supabase Dashboard -> Connect -> Session pooler (cổng 5432). Bỏ mật khẩu ra khỏi URL, điền ở DB_PASSWORD.
DATABASE_URL=postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Mật khẩu database (Project Settings -> Database -> Reset database password nếu quên)
DB_PASSWORD=

# https://<project-ref>.supabase.co - dùng để kiểm tra access token của mobile
SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard -> Project Settings -> API Keys -> Publishable key. Dùng cho đăng ký / đăng nhập.
SUPABASE_PUBLISHABLE_KEY=
# Nên có trước khi lên production (Secret key), kèm bật Authentication -> Rate Limits -> IP Address Forwarding.
# Thiếu thì Supabase thấy mọi user chung IP của server và dễ giới hạn đăng nhập. KHÔNG đưa key này vào app mobile.
SUPABASE_SECRET_KEY=
# Chỉ cần nếu project còn dùng JWT secret kiểu cũ (HS256). Project mới dùng JWKS, để trống.
SUPABASE_JWT_SECRET=

# mock = trả lời giả để chạy thử; openai = gọi GoClaw thật (/v1/chat/completions)
GOCLAW_MODE=mock
# Dự phòng khi goclaw_workspaces.api_key_secret_id chưa gắn secret trong Vault
GOCLAW_API_KEY=
GOCLAW_SESSION_HEADER=x-openclaw-session-key
GOCLAW_TIMEOUT_SECONDS=120
